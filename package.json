{
  "name": "digital-seba-monorepo",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "node scripts/dev-logs.js",
    "dev:dashboard": "bun scripts/dev-dashboard.ts",
    "dev:split": "turbo dev --filter=landing --filter=admin --filter=api",
    "dev:windows": "scripts\\dev-win.bat",
    "dev:landing": "turbo dev --filter=landing",
    "dev:admin": "turbo dev --filter=admin",
    "dev:api": "turbo dev --filter=api",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:migrate": "turbo run prisma:migrate --filter=@smartseba/database",
    "db:seed": "turbo run seed --filter=@smartseba/database"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "turbo": "^2.5.6",
    "typescript": "^5.7.3"
  }
}